# Copy to .env and fill in. Never commit .env.
# Shared keys can also live in ../.env (KpProjects/.env) and are loaded automatically.

# Cursor dashboard session cookie (WorkosCursorSessionToken from cursor.com)
CURSOR_SESSION_TOKEN=

# OpenCode API key (optional here if already set in ../.env)
OPENCODE_API_KEY=

# Optional: Gemini API key (health check only — cannot read usage history alone)
GEMINI_API_KEY=

# GCP project for AI Studio / Gemini usage via Cloud Monitoring
GCP_PROJECT_ID=653669929081

# Path to a GCP service account JSON with Monitoring Viewer
GOOGLE_APPLICATION_CREDENTIALS=

# Tracking window start (inclusive)
USAGE_SINCE=2026-08-28
